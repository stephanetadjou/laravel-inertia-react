+import { Link } from '@inertiajs/react';
+import { useEffect, useRef, useState } from 'react';
+
+import { NavSection } from './navigation';
+
+/*
+ * Applications NENTIX, à la manière d'Odoo : chaque rubrique du menu est une
+ * application avec sa couleur, sa phrase et son propre espace. Le lanceur
+ * (/apps) et le sélecteur d'applications de l'en-tête partagent ce style.
+ */
+
+export interface AppStyle {
+    /** Dégradé de la tuile (classes Tailwind). */
+    tile: string;
+    /** Phrase courte, centrée sur le client. */
+    tagline: string;
+}
+
+export const APP_STYLES: Record<string, AppStyle> = {
+    home: { tile: 'from-sky-500 to-blue-700', tagline: 'Vos chiffres et vos clients du jour' },
+    actions: { tile: 'from-amber-400 to-orange-600', tagline: 'Les clients à relancer aujourd’hui' },
+    discussions: { tile: 'from-emerald-400 to-green-600', tagline: 'WhatsApp, réponses auto et IA' },
+    agenda: { tile: 'from-violet-500 to-purple-700', tagline: 'Rendez-vous, cours et rappels' },
+    fleet: { tile: 'from-slate-500 to-slate-700', tagline: 'Véhicules, contrats et entretien' },
+    customers: { tile: 'from-blue-500 to-indigo-700', tagline: 'Fiches, fidélité et prospects' },
+    sales: { tile: 'from-cyan-500 to-teal-700', tagline: 'Ventes, formules et catalogue' },
+    invoices: { tile: 'from-indigo-500 to-blue-800', tagline: 'Devis acceptés sur WhatsApp, factures' },
+    cash: { tile: 'from-teal-400 to-emerald-700', tagline: 'Encaissements et clôture du soir' },
+    stock: { tile: 'from-orange-400 to-amber-600', tagline: 'Produits vendus avec vos prestations' },
+    expenses: { tile: 'from-rose-400 to-red-600', tagline: 'Dépenses du mois par catégorie' },
+    imports: { tile: 'from-zinc-500 to-zinc-700', tagline: 'Fichiers de ventes et de clients' },
+    analytics: { tile: 'from-fuchsia-500 to-pink-700', tagline: 'Pilotage, rapports et segments' },
+    campaigns: { tile: 'from-green-500 to-emerald-700', tagline: 'Messages ciblés à vos clients' },
+    settings: { tile: 'from-gray-500 to-gray-700', tagline: 'Entreprise, modules et équipe' },
+    platform: { tile: 'from-blue-900 to-slate-900', tagline: 'Back-office NENTIX' },
+};
+
+export const appStyle = (key: string): AppStyle => APP_STYLES[key] ?? { tile: 'from-blue-500 to-blue-700', tagline: '' };
+
+/** Icône d'application : carré arrondi en dégradé, icône blanche. */
+export function AppIcon({ section, size = 'md' }: { section: NavSection; size?: 'sm' | 'md' | 'lg' }) {
+    const box = size === 'lg' ? 'h-16 w-16 rounded-2xl [&_svg]:size-8' : size === 'sm' ? 'h-7 w-7 rounded-lg [&_svg]:size-4' : 'h-11 w-11 rounded-xl [&_svg]:size-5';
+
+    return (
+        <span className={`inline-flex shrink-0 items-center justify-center bg-gradient-to-br text-white shadow-sm ${appStyle(section.key).tile} ${box}`} aria-hidden="true">
+            {section.icon}
+        </span>
+    );
+}
+
+/** Bouton « grille » de l'en-tête : toutes les applications en un clic. */
+export function AppSwitcher({ sections, current }: { sections: NavSection[]; current?: string }) {
+    const [open, setOpen] = useState(false);
+    const ref = useRef<HTMLDivElement>(null);
+
+    useEffect(() => {
+        if (!open) return;
+        const close = (e: MouseEvent) => {
+            if (!ref.current?.contains(e.target as Node)) setOpen(false);
+        };
+        const esc = (e: KeyboardEvent) => e.key === 'Escape' && setOpen(false);
+        document.addEventListener('mousedown', close);
+        document.addEventListener('keydown', esc);
+        return () => {
+            document.removeEventListener('mousedown', close);
+            document.removeEventListener('keydown', esc);
+        };
+    }, [open]);
+
+    return (
+        <div className="relative" ref={ref}>
+            <button
+                type="button"
+                onClick={() => setOpen((v) => !v)}
+                aria-expanded={open}
+                aria-label="Toutes les applications"
+                title="Toutes les applications"
+                className="flex h-9 w-9 items-center justify-center rounded-lg text-white/90 hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-cyan-300"
+            >
+                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
+                    {[4, 10.5, 17].flatMap((y) => [4, 10.5, 17].map((x) => <rect key={`${x}-${y}`} x={x - 1.5} y={y - 1.5} width="4.5" height="4.5" rx="1.2" />))}
+                </svg>
+            </button>
+            {open && (
+                <div className="absolute top-11 left-0 z-[100000] w-[min(92vw,420px)] rounded-2xl border border-gray-200 bg-white p-3 shadow-2xl dark:border-gray-800 dark:bg-gray-900">
+                    <div className="grid grid-cols-3 gap-1 sm:grid-cols-4">
+                        {sections.map((section) => (
+                            <Link
+                                key={section.key}
+                                href={section.path}
+                                onClick={() => setOpen(false)}
+                                className={`flex flex-col items-center gap-1.5 rounded-xl p-2.5 text-center text-[12px] font-medium text-gray-700 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-white/5 ${
+                                    current === section.key ? 'bg-blue-50 dark:bg-white/10' : ''
+                                }`}
+                            >
+                                <AppIcon section={section} />
+                                <span className="leading-tight">{section.name}</span>
+                            </Link>
+                        ))}
+                    </div>
+                    <Link href="/apps" onClick={() => setOpen(false)} className="mt-2 block rounded-lg py-2 text-center text-xs font-semibold text-brand-text hover:bg-gray-50 dark:hover:bg-white/5">
+                        Ouvrir l’écran des applications
+                    </Link>
+                </div>
+            )}
+        </div>
+    );
+}
