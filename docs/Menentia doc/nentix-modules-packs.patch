+    const platform = buildSections(navContext(auth)).find((s) => s.key === 'platform');
+    const first = (auth.user?.name ?? '').split(' ').find((w) => !['Dr', 'Dr.', 'M.', 'Mme', 'Mlle', 'Pr'].includes(w)) ?? '';
+    const canManage = auth.user?.can_manage_organization ?? false;
+    const todo = badges.actions?.value ?? 0;
+
+    return (
+        <>
+            <Head title="Applications" />
+            <section className="nx-banner">
+                <div>
+                    <p className="text-sm text-cyan-100/90">{auth.organization?.name}</p>
+                    <h1 className="mt-1 text-2xl font-bold sm:text-3xl">
+                        {greeting} {first} !
+                    </h1>
+                    <p className="mt-1 max-w-xl text-[15px] text-white/85">
+                        {todo > 0 ? (
+                            <>
+                                <b>{todo} client{todo > 1 ? 's' : ''}</b> attend{todo > 1 ? 'ent' : ''} une action de votre part aujourd’hui.
+                            </>
+                        ) : (
+                            'Tous vos clients sont à jour. Belle journée !'
+                        )}
+                    </p>
+                </div>
+                <div className="flex flex-wrap items-center gap-2">
+                    {auth.organization?.pack_label && <span className="rounded-full bg-white/15 px-3 py-1 text-xs font-semibold">Pack {auth.organization.pack_label}</span>}
+                    {todo > 0 && (
+                        <Link href="/actions" className="rounded-xl bg-white px-4 py-2 text-sm font-semibold text-[#0B1F3A] shadow hover:bg-cyan-50">
+                            Voir les clients à relancer
+                        </Link>
+                    )}
+                </div>
+            </section>
+
+            {auth.organization?.automation === false && (
+                <div className="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
+                    <span>
+                        <b>Offre Gratuit :</b> vos relances partent à la main par lien WhatsApp. Passez à <b>Solo</b> pour les rappels, réponses et relances automatiques.
+                    </span>
+                    <Link href="/settings/modules" className="font-semibold underline">
+                        Voir les offres
+                    </Link>
+                </div>
+            )}
+
+            <div className="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
+                {sections.map((section) => {
+                    const badge = badges[section.key];
+                    return (
+                        <Link
+                            key={section.key}
+                            href={section.path}
+                            className="group relative flex flex-col gap-3 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-blue-500 dark:border-gray-800 dark:bg-gray-900"
+                        >
+                            <AppIcon section={section} size="lg" />
+                            <span>
+                                <span className="block text-[15px] font-semibold text-gray-900 dark:text-white">{section.name}</span>
+                                <span className="mt-0.5 block text-[12.5px] leading-snug text-gray-500 dark:text-gray-400">{appStyle(section.key).tagline}</span>
+                            </span>
+                            {badge && badge.value > 0 && (
+                                <span
+                                    className={`absolute top-3 right-3 rounded-full px-2 py-0.5 text-[11.5px] font-semibold ${
+                                        badge.tone === 'bad' ? 'bg-red-50 text-red-700' : 'bg-blue-50 text-blue-700'
+                                    }`}
+                                >
+                                    {badge.money ? formatNumber(badge.value) : badge.value} {badge.label}
+                                </span>
+                            )}
+                        </Link>
+                    );
+                })}
+                {canManage && (
+                    <Link
+                        href="/settings/modules"
+                        className="flex flex-col items-start gap-3 rounded-2xl border-2 border-dashed border-gray-300 p-4 text-gray-500 transition hover:border-blue-300 hover:text-blue-700 dark:border-gray-700"
+                    >
+                        <span className="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-gray-100 text-3xl dark:bg-white/5">+</span>
+                        <span>
+                            <span className="block text-[15px] font-semibold">Ajouter une application</span>
+                            <span className="mt-0.5 block text-[12.5px]">Factures, caisse, dépenses, fidélité…</span>
+                        </span>
+                    </Link>
+                )}
+            </div>
+
+            {platform && (
+                <p className="mt-6 text-sm">
+                    <Link href={platform.path} className="font-semibold text-brand-text hover:underline">
+                        Back-office NENTIX →
+                    </Link>
+                </p>
+            )}
+        </>
+    );
+}
+
+AppsIndex.layout = (page: React.ReactNode) => <AppLayout>{page}</AppLayout>;
+
+export default AppsIndex;
