+                                    <a href={doc.reminder_url} target="_blank" rel="noopener noreferrer" className="mdash-btn ghost" onClick={() => post('reminded')}>
+                                        <WhatsAppIcon />
+                                        Relancer
+                                    </a>
+                                )}
+                            </div>
+                        </Panel>
