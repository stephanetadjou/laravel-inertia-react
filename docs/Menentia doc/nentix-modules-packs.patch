+<?php
+
+/*
+ * Module « Devis et factures » (pack Équipe) : devis envoyé par lien
+ * WhatsApp et accepté en ligne, factures et factures d'acompte, paiements
+ * (chaque paiement est une vente du client : fiche, RFM, caisse du jour),
+ * relance des impayés.
+ */
