+/*
+ * Écran des applications (façon Odoo) : une tuile par application, chacune
+ * avec son chiffre du jour centré client. Un clic = l'espace de l'application.
+ */
+
+interface Badge {
+    value: number;
+    label: string;
+    money?: boolean;
+    tone?: 'bad';
+}
+
+interface PageProps {
+    auth: NavAuth & { user: { name: string } | null; organization?: { name?: string; pack_label?: string | null; automation?: boolean } | null };
+    badges: Record<string, Badge>;
+    locked: Record<string, string>;
+    greeting: string;
+    [key: string]: unknown;
+}
