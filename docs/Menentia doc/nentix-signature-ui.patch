+.nx-tab { position: relative; padding: 14px 2px 12px; font-size: 14px; color: #64748b; white-space: nowrap; }
+.nx-tab:hover { color: #0b1f3a; }
+.nx-tab[aria-current='page'] { color: #0b1f3a; font-weight: 600; }
+.nx-tab[aria-current='page']::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; border-radius: 3px 3px 0 0; background: linear-gradient(90deg, #1d4ed8, #06b6d4); }
+.dark .nx-tab { color: #94a3b8; } .dark .nx-tab[aria-current='page'], .dark .nx-tab:hover { color: #fff; }
+.nx-pulse { display: inline-flex; align-items: center; gap: 8px; border-radius: 999px; padding: 5px 12px 5px 8px; font-size: 13px; font-weight: 500; border: 1px solid; transition: transform 0.15s; }
+.nx-pulse:hover { transform: translateY(-1px); }
+.nx-pulse i { width: 8px; height: 8px; border-radius: 99px; flex-shrink: 0; animation: nx-beat 1.8s ease-in-out infinite; }
+.nx-pulse.bad { background: #fef2f2; border-color: #fecaca; color: #991b1b; } .nx-pulse.bad i { background: #ef4444; }
