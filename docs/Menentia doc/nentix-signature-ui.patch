+.nx-rail { background: #0b1f3a; background-image: radial-gradient(140% 50% at 0% 0%, rgba(29, 78, 216, 0.45), transparent 70%); }
+.nx-rail-item { position: relative; display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 6px 2px; border-radius: 14px; color: rgba(255, 255, 255, 0.72); font-size: 10.5px; line-height: 1.1; text-align: center; transition: background 0.15s, color 0.15s; }
+.nx-rail-item:hover { background: rgba(255, 255, 255, 0.07); color: #fff; }
+.nx-rail-item[aria-current='page'] { color: #fff; font-weight: 600; }
