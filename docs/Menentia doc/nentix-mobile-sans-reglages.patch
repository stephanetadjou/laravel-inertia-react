diff --git a/resources/js/layout/navigation.tsx b/resources/js/layout/navigation.tsx
index 55c8588..6addbf6 100755
--- a/resources/js/layout/navigation.tsx
+++ b/resources/js/layout/navigation.tsx
@@ -282,3 +282,35 @@ export function currentSection(sections: NavSection[], url: string): NavSection
     // Écrans de détail (/invoices/12) : l'application dont le chemin, sans paramètres, préfixe l'URL.
     return sections.find((s) => s.key !== 'home' && matches(url, s.path.split('?')[0]));
 }
+
+/*
+ * Téléphone : le paramétrage se fait sur ordinateur. On retire du menu les
+ * rubriques et onglets de configuration ; une URL de réglage ouverte sur
+ * téléphone affiche « À faire sur ordinateur » (cf. AppLayout).
+ */
+const MOBILE_HIDDEN_SECTIONS = ['settings', 'imports', 'platform'];
+const CONFIG_PREFIXES = [
+    '/organisation',
+    '/settings',
+    '/stores',
+    '/users',
+    '/roles',
+    '/ai-agents',
+    '/imports',
+    '/sales-imports',
+    '/templates',
+    '/plans',
+    '/catalog',
+    '/categories',
+    '/trainings',
+    '/sales-team',
+    '/customers/a-verifier',
+    '/apps/automations',
+    '/admin',
+];
+
+export const isConfigPath = (url: string) => CONFIG_PREFIXES.some((p) => url === p || url.startsWith(`${p}/`) || url.startsWith(`${p}?`));
+
+export function forMobile(sections: NavSection[]): NavSection[] {
+    return sections.filter((s) => !MOBILE_HIDDEN_SECTIONS.includes(s.key)).map((s) => ({ ...s, tabs: s.tabs.filter((t) => !isConfigPath(t.path)) }));
+}
diff --git a/resources/js/layout/useIsMobile.ts b/resources/js/layout/useIsMobile.ts
new file mode 100644
index 0000000..6aa16a7
--- /dev/null
+++ b/resources/js/layout/useIsMobile.ts
@@ -0,0 +1,16 @@
+import { useEffect, useState } from 'react';
+
+const QUERY = '(max-width: 767px)';
+
+/** Vrai sur téléphone (même seuil que les styles mobiles de nentix.css). */
+export default function useIsMobile(): boolean {
+    const [mobile, setMobile] = useState(() => typeof window !== 'undefined' && window.matchMedia(QUERY).matches);
+    useEffect(() => {
+        const mq = window.matchMedia(QUERY);
+        const update = () => setMobile(mq.matches);
+        update();
+        mq.addEventListener('change', update);
+        return () => mq.removeEventListener('change', update);
+    }, []);
+    return mobile;
+}
