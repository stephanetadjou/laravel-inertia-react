diff --git a/resources/css/nentix.css b/resources/css/nentix.css
index c396f44..99008e1 100755
--- a/resources/css/nentix.css
+++ b/resources/css/nentix.css
@@ -118,3 +118,62 @@
 @media (prefers-reduced-motion: reduce) { .nx-pulse i { animation: none; } }
 .nx-comb { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px 8px; }
 @media (min-width: 640px) { .nx-comb { grid-template-columns: repeat(4, 1fr); row-gap: 40px; } .nx-comb > :nth-child(4n+2), .nx-comb > :nth-child(4n+4) { transform: translateY(38px); } }
+
+/* ── Téléphone : NENTIX se comporte comme une application ─────────────────
+   Moins d'éléments que sur PC : sous-titres masqués, filtres repliés derrière
+   « Filtrer », chiffres en carrousel, tableaux réduits aux colonnes clés,
+   bouton principal flottant au-dessus de la barre du bas. */
+.mpage-filter-toggle { display: none; }
+@media (max-width: 767px) {
+  .nx-app main { padding: 12px 12px 0; }
+  .nx-app { -webkit-tap-highlight-color: transparent; }
+  .nx-app .nx-pulse-label { display: none; }
+  .nx-app .nx-pulse:not(:first-of-type) { display: none; }
+  .nx-app .nx-pulse { font-size: 12.5px; padding: 4px 10px 4px 7px; }
+
+  .nx-app .mdash-top { margin: 0 -12px; padding: 10px 12px; }
+  .nx-app .mdash-top h1 { font-size: 19px; }
+  .nx-app .mdash-top small, .nx-app .mdash-panel .mdash-sub { display: none; }
+  .nx-app .mdash-top-in { flex-wrap: nowrap; gap: 8px; }
+  .nx-app .mdash-top-in > div:first-child { min-width: 0; flex: 1; }
+  .nx-app .mpage-filter-toggle { display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0; height: 34px; padding: 0 14px; border-radius: 999px;
+    border: 1px solid var(--line); background: var(--surface); font-size: 13px; font-weight: 600; color: var(--ink); }
+  .nx-app .mpage-filter-toggle[aria-expanded='true'] { background: #0b1f3a; color: #fff; border-color: #0b1f3a; }
+  .nx-app .mpage-filters { display: none !important; }
+  .nx-app .mpage-filters.is-open { display: flex !important; flex-direction: column; align-items: stretch; gap: 10px; padding-top: 10px; }
+  .nx-app .mpage-filters.is-open .mdash-seg { overflow-x: auto; scrollbar-width: none; }
+  .nx-app .mpage-filters.is-open .mdash-seg button { white-space: nowrap; }
+
+  /* Actions : seul le bouton principal reste, en bouton flottant. */
+  .nx-app .mpage-actions > :not(.brand):not(.primary) { display: none; }
+  .nx-app .mpage-actions > :is(.brand, .primary) { position: fixed; right: 16px; bottom: calc(78px + env(safe-area-inset-bottom)); z-index: 9998; height: 50px;
+    padding: 0 20px; border-radius: 999px; font-size: 14.5px; box-shadow: 0 10px 24px -6px rgba(29, 78, 216, 0.55); }
+  .nx-app .mpage-actions > :is(.brand, .primary) ~ :is(.brand, .primary) { display: none; }
+
+  /* Chiffres : carrousel horizontal, cartes compactes. */
+  .nx-app .mpage-stats, .nx-app .nx-stats { flex-wrap: nowrap; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin: 0 -12px; padding: 0 12px 2px; }
+  .nx-app .mpage-stats::-webkit-scrollbar { display: none; }
+  .nx-app .mpage-stat { flex: 0 0 auto; min-width: 140px; scroll-snap-align: start; padding: 10px 12px; }
+  .nx-app .mpage-stat b { font-size: 19px; }
+  .nx-app .mpage-stat small { display: none; }
+
+  /* Tableaux : les 2 premières colonnes et la dernière (souvent montant ou action). */
+  .nx-app .mpage-table th:nth-child(n + 3):not(:last-child),
+  .nx-app .mpage-table td:nth-child(n + 3):not(:last-child) { display: none; }
+  .nx-app .mpage-table th, .nx-app .mpage-table td { padding-left: 8px; padding-right: 8px; }
+  .nx-app .mpage-table td { white-space: normal; }
+  .nx-app .mdash-panel, .nx-app .mpage-panel { border-radius: 16px; }
+  .nx-app .mpage-pager .btns { margin-left: auto; }
+
+  /* Pas d'effets de survol sur un écran tactile. */
+  .nx-app .group:hover .group-hover\:-translate-y-0\.5, .nx-app .nx-pulse:hover { transform: none; }
+
+  /* Fiches clients : la recherche et « Nouveau client » suffisent sur téléphone. */
+  .nx-app .mcust-actions select, .nx-app .mcust-consent, .nx-app .mcust-actions > :not(.brand):not(.mcust-search) { display: none; }
+  .nx-app .mcust-actions .mcust-search { width: 100%; height: 42px; border-radius: 999px; padding: 0 16px; }
+  .nx-app .mcust-actions > .brand { position: fixed; right: 16px; bottom: calc(78px + env(safe-area-inset-bottom)); z-index: 9998; height: 50px; padding: 0 20px;
+    border-radius: 999px; font-size: 14.5px; box-shadow: 0 10px 24px -6px rgba(29, 78, 216, 0.55); }
+  .nx-app .mpage-rowlinks > * { white-space: nowrap; }
+  .nx-app .mcust-actions .mdash-btn:not(.brand) { display: none; }
+  .nx-app main { overflow-x: clip; }
+}
