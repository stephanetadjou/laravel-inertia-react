APP_NAME=ClientlyX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v21.0
# cloud = vraie API Meta ; log = simulation locale sans appel externe (ignoré en production)
WHATSAPP_DRIVER=cloud
# En local derrière un tunnel (ngrok, cloudflared) : adresse publique https
# affichée dans l'URL de rappel du webhook (Paramètres › WhatsApp). Vide = APP_URL.
WHATSAPP_WEBHOOK_BASE_URL=
# App Meta de ClientlyX (numéros « gérés par ClientlyX », réglés dans le
# back-office) : token permanent de l'utilisateur système ClientlyX, App Secret
# de l'app, et jeton de vérification du webhook unique {APP_URL}/webhooks/whatsapp
CLIENTLYX_WHATSAPP_TOKEN=
CLIENTLYX_WHATSAPP_APP_SECRET=
CLIENTLYX_WHATSAPP_VERIFY_TOKEN=
# Envoi des campagnes par lots (un job par lot) et pause entre deux messages (ms)
WHATSAPP_BATCH_SIZE=50
WHATSAPP_SEND_DELAY_MS=100
# Coût estimé avant envoi, par message (indicatif, à ajuster selon la grille Meta)
WHATSAPP_PRICE_CURRENCY=USD
WHATSAPP_PRICE_MARKETING=0.0225
WHATSAPP_PRICE_UTILITY=0.004
WHATSAPP_PRICE_AUTHENTICATION=0.004

# SQLite : délai d'attente (ms) quand un autre processus écrit (worker, sessions, cache)
DB_BUSY_TIMEOUT=5000

# Site vitrine (formulaire « Demander une démo »)
# (les anciens noms MENENTIA_* restent lus en repli si les CLIENTLYX_* sont absents)
CLIENTLYX_SITE_URL=https://clientlyx.com
CLIENTLYX_LEADS_EMAIL=
# Entreprise maison (slug) : les demandes du site y deviennent des fiches prospects
CLIENTLYX_HOUSE_ORG=mercure-solutions
CLIENTLYX_SUPPORT_EMAIL=contact@clientlyx.com
# Numéro WhatsApp du support (lien « Besoin d'aide ? », format international sans +)
CLIENTLYX_SUPPORT_WHATSAPP=

# Phase de test : sélecteur des entreprises de démo par secteur (barre du haut). Ignoré en production.
DEMO_SWITCHER=false

# Assistant IA ClientlyX (config/clientlyx_ai.php) : IA Haiku, recherche par le sens, notes vocales
CLIENTLYX_AI_ENABLED=false
CLIENTLYX_ANTHROPIC_KEY=
CLIENTLYX_EMBEDDINGS_DRIVER=none
CLIENTLYX_EMBEDDINGS_KEY=
CLIENTLYX_TRANSCRIPTION_KEY=

# Connexion WhatsApp en 5 minutes (inscription intégrée Meta, coexistence) : app Meta ClientlyX
CLIENTLYX_META_APP_ID=
CLIENTLYX_META_ES_CONFIG_ID=
CLIENTLYX_META_ES_COEXISTENCE=true
